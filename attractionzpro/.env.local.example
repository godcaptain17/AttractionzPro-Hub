# ============================================================
# AttractionzPro Hub — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── JWT Secret (generate with: openssl rand -base64 64) ───
JWT_SECRET=your-super-secret-jwt-key-at-least-64-chars-long

# ── Resend (Email) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@attractionzprohub.com
ADMIN_EMAIL=admin@attractionzprohub.com

# ── Site Config ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.attractionzprohub.com
NEXT_PUBLIC_BUSINESS_NAME=AttractionzPro Hub
NEXT_PUBLIC_BUSINESS_PHONE=+2348023208886
NEXT_PUBLIC_BUSINESS_ADDRESS=2-14 James Robertson Rd, Surulere, Lagos 101241
NEXT_PUBLIC_WHATSAPP_NUMBER=2348023208886

# ── Google Maps ───────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Admin Seed (used only once during setup) ─────────────
# After running migrations, execute in Supabase SQL Editor:
# SELECT seed_admin('value-of-ADMIN_SEED_EMAIL', 'value-of-ADMIN_SEED_PASSWORD');
ADMIN_SEED_EMAIL=admin@attractionzprohub.com
ADMIN_SEED_PASSWORD=ChangeMe_SuperSecure_123!
